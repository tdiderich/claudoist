{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TodoItem",
  "type": "object",
  "properties": {
    "text": {"type": "string"},
    "status": {"type": "string", "enum": ["open", "done", "waiting", ""]},
    "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3", ""]},
    "owner": {"type": "string"},
    "due": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$|^$"},
    "ref": {"type": "string"}
  },
  "additionalProperties": true
}
